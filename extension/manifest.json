{
  "manifest_version": 3,
  "name": "Antigravity in Chrome",
  "version": "2.0.0",
  "description": "Zero-flag live browser bridge, color-coded Tab Groups, file transfers, and multi-tab control for Antigravity Computer Control.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Antigravity in Chrome",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "downloads",
    "cookies",
    "storage",
    "history",
    "bookmarks",
    "webNavigation",
    "scripting",
    "nativeMessaging",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
