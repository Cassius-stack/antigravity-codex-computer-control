{
  "manifest_version": 3,
  "name": "Antigravity in Chrome",
  "version": "3.0.0",
  "description": "Docked Antigravity Side Panel chat bar + live zero-flag browser bridge, color-coded Tab Groups, file transfers, and scheduled workflows.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Antigravity Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle Antigravity in Chrome Side Panel"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "debugger",
    "tabs",
    "tabGroups",
    "downloads",
    "cookies",
    "storage",
    "history",
    "bookmarks",
    "webNavigation",
    "scripting",
    "nativeMessaging",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
