{
  "name": "antigravity-codex-computer-control",
  "version": "2.0.0",
  "description": "Self-contained macOS Multi-Window App & Live Browser Computer-Use MCP Server + MV3 Extension + Antigravity Plugin (Codex CUA, Tab Groups & Daintier Cursor Parity)",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "antigravity-computer-use-mcp": "src/server.mjs",
    "antigravity-native-host": "bin/antigravity-native-host.mjs"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "setup": "node scripts/setup-antigravity.mjs",
    "check": "node scripts/setup-antigravity.mjs --check",
    "uninstall-mcp": "node scripts/setup-antigravity.mjs --uninstall",
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
